# Audio source to stream. Restart after changing: pm2 restart music-share
# List available sources: ./capture/MusicShareCapture.app/Contents/MacOS/MusicShareCapture --list
#   app:com.bitgapp.eqmac        eqMac's enhanced output, captured from the eqMac app (doesn't disturb its driver)
#   EQMOutputExport              eqMac Export device (can make eqMac lose its driver; avoid)
#   system                       Everything your Mac plays, no driver (don't combine with eqMac: you'd get both copies)
#   (app: and system need System Audio Recording permission for Music Share Capture)
#   BlackHole2ch_UID             BlackHole 2ch
#   BuiltInHeadphoneInputDevice  External Microphone
AUDIO_SOURCE="app:com.bitgapp.eqmac"

PORT=80
